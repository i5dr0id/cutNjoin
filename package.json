{
  "name": "cutnjoin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "typegen": "sanity schema extract --path src/sanity/schema.json --enforce-required-fields --force && sanity typegen generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sanity/image-url": "^2.1.1",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.0",
    "sanity": "^6.13.2",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
